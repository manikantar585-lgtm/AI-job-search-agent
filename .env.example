# Job sources to search (comma separated): remotive, arbeitnow, adzuna, sample
SOURCES=remotive,arbeitnow,sample

# Optional: Adzuna has India listings. Free key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Optional: LLM with tool calling (Groq free tier works)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
